{
  "info": {
    "name": "csci599-a1 market watcher",
    "description": "Canonical query set from AGENTS.md against POST /chat. Run requests in order: later ones depend on session memory. A fresh session_id is generated per run unless the environment sets one.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('session_id')) {",
          "  pm.environment.set('session_id', 'pm-' + Date.now());",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "GET /health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Why did NVDA drop today?",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('has non-empty response', () => pm.expect(body.response).to.be.a('string').and.not.empty);",
              "pm.test('has tool_calls array', () => pm.expect(body.tool_calls).to.be.an('array'));",
              "const tools = body.tool_calls.map(t => t.tool);",
              "console.log('tool_calls:', JSON.stringify(body.tool_calls));",
              "pm.test('called get_quote', () => pm.expect(tools).to.include('get_quote'));",
              "pm.test('called one of [\"tavily_search\", \"get_company_news\"]', () => pm.expect(tools.some(t => [\"tavily_search\", \"get_company_news\"].includes(t))).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/chat",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "chat"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"Why did NVDA drop today?\",\n  \"session_id\": \"{{session_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
